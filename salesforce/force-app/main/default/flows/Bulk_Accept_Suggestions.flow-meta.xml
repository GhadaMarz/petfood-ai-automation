<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <assignments>
        <name>Accept_Row</name>
        <label>Accept Row</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Each_Product.Brand__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>NewBrand</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Each_Product.Weight_g__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>NewWeight</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Each_Product.Countries__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>NewCountries</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Each_Product.Suggested_Countries__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Each_Product.Suggested_Brand__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Each_Product.Suggested_Weight_g__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>NoWeight</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Each_Product.Review_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Corrected</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ProductsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Each_Product</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>AcceptedCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Each_Product</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Has_Any_Suggestion</name>
        <label>Has Any Suggestion</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Suggestion</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Suggestion</defaultConnectorLabel>
        <rules>
            <name>Has_Suggestion</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Products</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Select_Changes</targetReference>
            </connector>
            <label>Has Suggestion</label>
        </rules>
    </decisions>
    <decisions>
        <name>Any_Row_Selected</name>
        <label>Any Row Selected</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Done</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>None Selected</defaultConnectorLabel>
        <rules>
            <name>Rows_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AcceptedCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Products</targetReference>
            </connector>
            <label>Rows Selected</label>
        </rules>
    </decisions>
    <description>Lists every Pet Food Product with a pending brand, weight or countries suggestion, all checked. The data steward unchecks the rows to leave unchanged; for each checked row the available suggestions replace the current values, the suggestions are cleared and Review Status becomes Corrected. Unchecked rows are not modified.</description>
    <environments>Default</environments>
    <formulas>
        <name>NewBrand</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!Each_Product.Suggested_Brand__c}, {!Each_Product.Brand__c})</expression>
    </formulas>
    <formulas>
        <name>NewCountries</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!Each_Product.Suggested_Countries__c}, {!Each_Product.Countries__c})</expression>
    </formulas>
    <formulas>
        <name>NewWeight</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!Each_Product.Suggested_Weight_g__c}), {!Each_Product.Weight_g__c}, {!Each_Product.Suggested_Weight_g__c})</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Bulk Accept Suggestions {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Bulk Accept Suggestions</label>
    <loops>
        <name>Each_Product</name>
        <label>Each Product</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Products_Table.selectedRecords</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Accept_Row</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Any_Row_Selected</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Products</name>
        <label>Get Products</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Any_Suggestion</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Suggested_Brand__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Suggested_Weight_g__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Suggested_Countries__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Pet_Food_Product__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Product_Name__c</queriedFields>
        <queriedFields>Brand__c</queriedFields>
        <queriedFields>Suggested_Brand__c</queriedFields>
        <queriedFields>Weight_g__c</queriedFields>
        <queriedFields>Suggested_Weight_g__c</queriedFields>
        <queriedFields>Countries__c</queriedFields>
        <queriedFields>Suggested_Countries__c</queriedFields>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Products</name>
        <label>Update Products</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Done</targetReference>
        </connector>
        <inputReference>ProductsToUpdate</inputReference>
    </recordUpdates>
    <screens>
        <name>Select_Changes</name>
        <label>Select Changes</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Each_Product</targetReference>
        </connector>
        <fields>
            <name>Instructions</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Accept suggestions in bulk&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Every product with a pending brand, weight or countries suggestion is listed and checked. Uncheck the products you do not want to change, then click Accept. For each checked product, the suggested brand, weight and countries replace the current values and Review Status becomes Corrected. Unchecked products are left unchanged.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Products_Table</name>
            <extensionName>c:suggestionReviewTable</extensionName>
            <fieldType>ComponentInstance</fieldType>
            <inputParameters>
                <name>records</name>
                <value>
                    <elementReference>Get_Products</elementReference>
                </value>
            </inputParameters>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <storeOutputAutomatically>true</storeOutputAutomatically>
        </fields>
        <nextOrFinishButtonLabel>Accept</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
