    <description>Shows the brand, weight and countries suggestions of a Pet Food Product. If the data steward accepts, the available suggestions replace the current values and Review Status becomes Corrected; if the steward rejects, the suggestions are cleared and Review Status becomes Validated.</description>
    <environments>Default</environments>
    <formulas>
        <name>BrandLine</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Product.Suggested_Brand__c}), &quot;Brand: no suggestion&quot;, &quot;Brand: &quot; &amp; BLANKVALUE({!Get_Product.Brand__c}, &quot;(empty)&quot;) &amp; &quot;  →  &quot; &amp; {!Get_Product.Suggested_Brand__c})</expression>
    </formulas>
    <formulas>
        <name>CountryLine</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Product.Suggested_Countries__c}), &quot;Countries: no suggestion&quot;, &quot;Countries: &quot; &amp; BLANKVALUE({!Get_Product.Countries__c}, &quot;(empty)&quot;) &amp; &quot;  →  &quot; &amp; {!Get_Product.Suggested_Countries__c})</expression>
    </formulas>
    <formulas>
        <name>WeightLine</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Product.Suggested_Weight_g__c}), &quot;Weight: no suggestion&quot;, &quot;Weight (g): &quot; &amp; IF(ISBLANK({!Get_Product.Weight_g__c}), &quot;(empty)&quot;, TEXT({!Get_Product.Weight_g__c})) &amp; &quot;  →  &quot; &amp; TEXT({!Get_Product.Suggested_Weight_g__c}))</expression>
    </formulas>
